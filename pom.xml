<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.provguard</groupId>
  <artifactId>provguard-agent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ProvGuard Agent</name>
  <description>
    Java Agent + provenance capture for dangerous-sink instrumentation.
    Hour-1 proof-of-concept slice: ByteBuddy hook on ProcessBuilder.start(),
    StackWalker-based provenance capture, in-memory event buffer.
    This is a starting slice, not the full ProvGuard architecture described in docs/ARCHITECTURE.md.
  </description>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <byte-buddy.version>1.15.11</byte-buddy.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${byte-buddy.version}</version>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <version>${byte-buddy.version}</version>
    </dependency>
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>1.20.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>provguard-agent</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!--
            Attaches the REAL agent via -javaagent at JVM startup (premain),
            instead of relying solely on ByteBuddyAgent.install() dynamic
            self-attach inside each test's @BeforeAll. This matters: JUnit
            must fully load (and verify) every test class to discover its
            @Test methods before running any @BeforeAll, and verifying a
            class's field declarations can eagerly resolve referenced types
            (e.g. `private final AnomalyDetector detector = ...`) via the
            application classloader - before any @BeforeAll in that same
            class gets a chance to run BootstrapInjector first. Attaching at
            true JVM startup guarantees provguard.* classes are already
            bootstrap-visible before Surefire loads even the FIRST test
            class. See docs/DESIGN_DECISIONS.md section 4G.
          -->
          <argLine>-XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -javaagent:${project.build.directory}/provguard-agent-early.jar</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>default-jar</id>
            <configuration>
              <archive>
                <manifestEntries>
                  <Premain-Class>provguard.agent.AgentBootstrap</Premain-Class>
                  <Agent-Class>provguard.agent.AgentBootstrap</Agent-Class>
                  <Can-Redefine-Classes>true</Can-Redefine-Classes>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                  <Launcher-Agent-Class>provguard.agent.AgentBootstrap</Launcher-Agent-Class>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
          <execution>
            <!--
              Early, unshaded jar containing only our own compiled classes
              (ByteBuddy is resolved via Surefire's normal test classpath,
              which is also placed on the system classpath by -javaagent).
              Bound before the `test` phase specifically so it exists in
              time for Surefire's argLine above - the default/shaded jars
              are only built later, at `package`, which runs after `test`.
            -->
            <id>early-agent-jar-for-tests</id>
            <phase>process-test-classes</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classesDirectory>${project.build.outputDirectory}</classesDirectory>
              <classifier>early</classifier>
              <archive>
                <manifestEntries>
                  <Premain-Class>provguard.agent.AgentBootstrap</Premain-Class>
                  <Agent-Class>provguard.agent.AgentBootstrap</Agent-Class>
                  <Can-Redefine-Classes>true</Can-Redefine-Classes>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Premain-Class>provguard.agent.AgentBootstrap</Premain-Class>
                    <Agent-Class>provguard.agent.AgentBootstrap</Agent-Class>
                    <Can-Redefine-Classes>true</Can-Redefine-Classes>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
